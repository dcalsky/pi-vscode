{
  "name": "wordwrap-link-mre",
  "displayName": "Wrapped Terminal Link MRE",
  "description": "Minimal VS Code webview/xterm reproduction for links split by terminal soft wrap.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:wrappedLinkMre.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wrappedLinkMre.open",
        "title": "Wrapped Link MRE: Open"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/wrapped-link-provider.test.js",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository --out wordwrap-link-mre-0.0.1.vsix"
  },
  "dependencies": {
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0"
  }
}
