{
  "name": "pi-vscode",
  "displayName": "Pi",
  "description": "Run and resume pi coding-agent sessions inside VS Code.",
  "version": "0.0.18",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:piAgent.open",
    "onView:piAgent.view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piAgent.open",
        "title": "Pi: Open",
        "icon": "$(terminal)"
      },
      {
        "command": "piAgent.newSession",
        "title": "Pi: New Session",
        "icon": "$(add)"
      },
      {
        "command": "piAgent.closeSessionOrView",
        "title": "Pi: Close Active Session or View"
      }
    ],
    "keybindings": [
      {
        "command": "piAgent.closeSessionOrView",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "win": "ctrl+f4",
        "when": "focusedView == piAgent.view"
      }
    ],
    "configuration": {
      "title": "Pi",
      "properties": {
        "piAgent.command": {
          "type": "string",
          "default": "pi",
          "description": "Executable or absolute path used to start pi."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "piAgent",
          "title": "Pi",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "piAgent": [
        {
          "type": "webview",
          "id": "piAgent.view",
          "name": "Pi",
          "icon": "$(terminal)",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "piAgent.open",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test out/test/session-store.test.js out/test/session-view.test.js out/test/status-bridge.test.js out/test/terminal-links.test.js out/test/terminal-link-provider.test.js out/test/view-state.test.js",
    "package": "npm version patch --no-git-tag-version --ignore-scripts && npx --yes @vscode/vsce package"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/vscode": "1.85.0",
    "typescript": "5.9.3"
  }
}
