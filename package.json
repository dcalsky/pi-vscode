{
  "name": "pi-coding",
  "displayName": "Pi Coding",
  "description": "Run pi coding-agent sessions in VS Code: several sessions side by side, live status for each one, and file paths that open in the editor.",
  "version": "0.0.44",
  "publisher": "EthanChow",
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dcalsky/pi-vscode.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "pi",
    "coding agent",
    "terminal",
    "session",
    "agent"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:piAgent.open",
    "onView:piAgent.view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piAgent.open",
        "title": "Pi: Open",
        "icon": "$(terminal)"
      },
      {
        "command": "piAgent.newSession",
        "title": "Pi: New Session",
        "icon": "$(add)"
      },
      {
        "command": "piAgent.closeSessionOrView",
        "title": "Pi: Close Active Session or View"
      }
    ],
    "keybindings": [
      {
        "command": "piAgent.closeSessionOrView",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "win": "ctrl+f4",
        "when": "focusedView == piAgent.view"
      }
    ],
    "configuration": {
      "title": "Pi",
      "properties": {
        "piAgent.command": {
          "type": "string",
          "default": "pi",
          "description": "Executable or absolute path used to start pi. Leave as pi to auto-detect (including npm's pi.cmd on Windows); set an absolute path when detection cannot find it."
        },
        "piAgent.closeBehavior": {
          "type": "string",
          "enum": [
            "detach",
            "stop"
          ],
          "enumDescriptions": [
            "Closing a session tab (or Cmd/Ctrl+W) only hides it; the Pi process keeps running and the session can be reopened from the list.",
            "Closing a session tab (or Cmd/Ctrl+W) stops the Pi process and closes the tab."
          ],
          "default": "detach",
          "description": "What closing a session tab does."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "piAgent",
          "title": "Pi",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "piAgent": [
        {
          "type": "webview",
          "id": "piAgent.view",
          "name": "Pi",
          "icon": "$(terminal)",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "piAgent.open",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test out/test/clipboard.test.js out/test/pi-command.test.js out/test/session-actions.test.js out/test/session-store.test.js out/test/session-view.test.js out/test/status-bridge.test.js out/test/terminal-links.test.js out/test/terminal-link-provider.test.js out/test/terminal-copy.test.js out/test/ime.test.js out/test/view-state.test.js out/test/xterm-options.test.js",
    "package": "npm version patch --no-git-tag-version --ignore-scripts && npx --yes @vscode/vsce package"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.12.0-beta.292",
    "@xterm/addon-search": "0.17.0-beta.292",
    "@xterm/addon-unicode11": "0.10.0-beta.292",
    "@xterm/addon-web-links": "0.13.0-beta.292",
    "@xterm/addon-webgl": "0.20.0-beta.291",
    "@xterm/xterm": "6.1.0-beta.292",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/vscode": "1.85.0",
    "typescript": "5.9.3"
  }
}
